   </wvobject>
   <wvobject fp_name="/tb/i0" type="logic">
      <obj_property name="ElementShortName">i0</obj_property>
      <obj_property name="ObjectShortName">i0</obj_property>
   </wvobject>
   <wvobject fp_name="/tb/i1" type="logic">
